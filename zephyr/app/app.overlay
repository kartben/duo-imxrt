 *
 * USB MIDI function exposed by the firmware, and the LEDs the recovery path
 * lights. These are application-level choices rather than properties of the
 * board, so they live here.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		/*
		 * The oscillator, filter and envelope indicator LEDs, driven
		 * as plain GPIOs (they are active low) to show that the DUO
		 * has gone into the serial downloader on the power-on
		 * recovery combination; see src/platform/recovery.cpp.
		 */
		recovery-led-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>,
				     <&gpio1 5 GPIO_ACTIVE_LOW>,
				     <&gpio1 3 GPIO_ACTIVE_LOW>;
	};

	usb_midi: usb_midi {
		compatible = "zephyr,midi2-device";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		label = "Dato DUO";

		midi_in_out@0 {
			reg = <0 1>;
			protocol = "midi1-up-to-128b";
			label = "Dato DUO MIDI";
		};
	};
};
